{
	"manifest_version": 3,
	"name": "Privag AI",
	"version": "1.0",
	"permissions": [
		"scripting",
		"offscreen",
		"sidePanel",
		"storage"
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
	},
	"host_permissions": [
		"<all_urls>"
	],
	"background": {
		"service_worker": "background.js"
	},
	"side_panel": {
		"default_path": "sidepanel.html"
	},
	"action": {
		"default_title": "Open Privag AI Side Panel"
	}
}
