# Privag AI server: environment variables (all optional).
#
# Copy this file to server/.env and fill in what you need: `python app.py` loads server/.env at startup
# (with python-dotenv, from requirements.txt), from whatever folder you start it. server/.env stays out of
# git (.gitignore). A variable already set in your shell wins over the file, e.g. for one run:
#   PowerShell:  $env:PRIVAG_PORT = "5001"; python app.py
#   bash/zsh:    PRIVAG_PORT=5001 python app.py
#
# Effective LLM config = config.default.json  <-  config.json (saved by the dashboard)  <-  these variables,
# so a value set here overrides the dashboard (the dashboard shows which fields are overridden).
# An empty variable counts as unset. An invalid value is ignored with a warning on stderr.

# Base URL of any OpenAI-compatible chat completions endpoint (http:// or https://).
# Ollama: http://localhost:11434/v1   vLLM: http://localhost:8000/v1
PRIVAG_LLM_URL=

# Model name as the endpoint knows it.
# Ollama: gemma4:31b-it-q4_K_M   vLLM: google/gemma-4-31B-it
PRIVAG_LLM_MODEL=

# Sent as "Authorization: Bearer <key>". Leave empty for a local Ollama/vLLM without auth.
PRIVAG_LLM_API_KEY=

# Seconds to wait for one model reply (1 to 3600; default 600 from config.default.json).
PRIVAG_LLM_TIMEOUT=

# Interface to listen on. Default 127.0.0.1 (this machine only). 0.0.0.0 lets other machines call the
# agent API (/api); use it only on a network you trust. The setup page and /api/config still answer only
# at http://localhost:<port>/ on this machine (anyone who can edit them decides where frames are sent).
PRIVAG_HOST=

# Port to listen on. Default 5000. Change it if 5000 is taken (e.g. by another app), and set the same URL
# in the extension's side panel (Server URL).
PRIVAG_PORT=

# 1 turns on the Werkzeug debugger (tracebacks with source code and an interactive console). Default off.
# Development only; never on a shared network.
PRIVAG_DEBUG=

# 0 stops the server from opening its setup page in your browser when it starts. Default 1 (opens it once).
PRIVAG_OPEN_DASHBOARD=
