# Privag AI server: environment variables (all optional).
#
# The server reads these from the process environment only. It does NOT load .env files itself, so
# either set them in your shell before `python app.py`, or load this file with a tool of your choice.
#   PowerShell:  $env:PRIVAG_LLM_MODEL = "gemma4:31b-it-q4_K_M"; python app.py
#   bash/zsh:    PRIVAG_LLM_MODEL=gemma4:31b-it-q4_K_M python app.py
# If you copy this file to server/.env, it stays out of git (.gitignore).
#
# Effective LLM config = config.default.json  <-  config.json (saved by the dashboard)  <-  these variables.
# An empty variable counts as unset. An invalid value is ignored with a warning on stderr.

# Base URL of any OpenAI-compatible chat completions endpoint (http:// or https://).
# Ollama: http://localhost:11434/v1   vLLM: http://localhost:8000/v1
PRIVAG_LLM_URL=

# Model name as the endpoint knows it.
# Ollama: gemma4:31b-it-q4_K_M   vLLM: google/gemma-4-31B-it
PRIVAG_LLM_MODEL=

# Sent as "Authorization: Bearer <key>". Leave empty for a local Ollama/vLLM without auth.
PRIVAG_LLM_API_KEY=

# Seconds to wait for one model reply (1 to 3600; default 600 from config.default.json).
PRIVAG_LLM_TIMEOUT=
